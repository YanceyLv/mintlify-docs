{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "RouteStack",
  "description": "RouteStack documentation for API access, authentication, models, pricing, and integration guides.",
  "colors": {
    "primary": "#2563EB"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/logo/favicon.svg",
  "seo": {
    "metatags": {
      "canonical": "https://docs.routestack.cn"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "models",
              "pricing"
            ]
          },
          {
            "group": "Help",
            "pages": [
              "faq"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Endpoints",
            "pages": [
              "api-reference/models",
              "api-reference/chat-completions",
              "api-reference/responses"
            ]
          }
        ]
      }
    ]
  }
}
